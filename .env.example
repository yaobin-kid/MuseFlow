# ============================================================
# MuseFlow 环境变量配置（复制为 .env 后修改）
# 大部分参数均支持环境变量；控制台「系统设置」中的修改会持久化到数据库并优先于此处默认值
# ============================================================

# ---------- 基础 ----------
APP_NAME=MuseFlow
HOST=0.0.0.0
PORT=8000
TZ=Asia/Shanghai
DATA_DIR=./data

# 登录账号（生产环境请务必修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# JWT 签名密钥，建议改为随机长字符串
SECRET_KEY=please-change-me-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=10080

# 演示模式：首次启动填充示例榜单数据，便于直接查看控制台效果
# 接入真实平台采集时请设为 false
DEMO_MODE=true
COLLECT_ON_STARTUP=false

# ---------- 上游音源服务 ----------
UPSTREAM_BASE_URL=https://music.gdstudio.xyz
UPSTREAM_TIMEOUT_SEC=60
UPSTREAM_BITRATE=999
UPSTREAM_SOURCE_ORDER=netease,tencent,kugou,kuwo,migu,joox,spotify,apple
# 上游下载接口返回 JSON 后，按此模板拉取音频文件
UPSTREAM_FILE_PATH_TEMPLATE=/music/{filename}
# 上游「歌曲封面图片数据」接口路径（参数 source、id）
UPSTREAM_COVER_PATH=/api/pic
# 上游「仅歌词下载」接口路径
UPSTREAM_LYRIC_PATH=/api/lyric

# ---------- 网络与防风控 ----------
PROXY_URL=
FLARESOLVERR_ENABLED=false
FLARESOLVERR_URL=http://flaresolverr:8191/v1
FLARESOLVERR_TIMEOUT_SEC=60
COOLDOWN_BASE_SEC=15
COOLDOWN_JITTER_SEC=10

# ---------- 上游限流 ----------
RATE_LIMIT_WINDOW_SEC=300
RATE_LIMIT_MAX_REQUESTS=50

# ---------- 动态打分 ----------
MIN_DOWNLOAD_SCORE=75
# 权重默认偏向 Spotify / Apple Music，便于纳入更多英文热门曲目
WEIGHT_NETEASE=0.15
WEIGHT_QQ=0.15
WEIGHT_SPOTIFY=0.35
WEIGHT_APPLE=0.35
BLACKLIST_KEYWORDS=DJ,喊麦,伴奏,铃声,串烧

# ---------- Navidrome ----------
NAVIDROME_ENABLED=false
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=
NAVIDROME_MATCH_MODE=strict
NAVIDROME_AUTO_SCAN=true
# 索引同步完成后自动在 Navidrome 创建/刷新对应歌单（仅保留最新榜单曲目）
NAVIDROME_SYNC_PLAYLISTS=true
# Navidrome 歌单名称前缀，最终名称形如「MuseFlow · 网易云音乐 · 热歌榜」
NAVIDROME_PLAYLIST_PREFIX=MuseFlow
# 下载完成后等待扫库完成的延迟（秒）再刷新歌单
NAVIDROME_PLAYLIST_REFRESH_DELAY_SEC=30

# ---------- 目录 ----------
TEMP_DOWNLOAD_DIR=./data/downloads/temp
FINAL_MUSIC_DIR=./data/music_library

# ---------- Webhook 通知 ----------
WEBHOOK_ENABLED=false
WEBHOOK_TYPE=generic
WEBHOOK_URL=
WEBHOOK_EVENTS=job_completed,manual_download_completed,error_alert

# ---------- 定时任务 ----------
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=360
NAVIDROME_SYNC_INTERVAL_MINUTES=60

# ---------- Spotify（全球与多市场 Top 50，侧重英文热门曲目） ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=TW
# 可选：自定义歌单 JSON，覆盖内置 9 个 Top 50，如 [{"id":"37i9dQZEVXbMDoHDwVN2tF","name":"Global Top 50"}]
SPOTIFY_PLAYLISTS_JSON=
